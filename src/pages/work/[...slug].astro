---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
    const items = await getCollection('portfolio');
    return items.map((item) => ({ params: { slug: item.id } }));
}

const { slug } = Astro.params;
const item = await getEntry('portfolio', slug!);
if (!item) {
    throw new Error('Case study not found');
}
const { title, summary, cover, tags, website } = item.data;
const { Content } = await render(item);
---

<Layout title={title}>
    <article class="mx-auto max-w-3xl px-4 py-10">
        <header class="mb-8">
            <h1 class="mb-3 text-navy">{title}</h1>
            <p class="text-navy/80">{summary}</p>
        </header>
        {cover && <img src={cover} alt={title} loading="lazy" class="mb-8 rounded-md" />}
        <div class="markdown">
            <Content />
        </div>
        {
            website && (
                <a href={website} target="_blank" class="btn btn-primary mt-6">
                    Visit Website
                </a>
            )
        }
        {
            tags?.length ? (
                <ul class="mt-8 flex flex-wrap gap-2 text-xs">
                    {tags.map((t) => (
                        <li class="rounded-full bg-sky/10 px-2 py-1 text-sky">#{t}</li>
                    ))}
                </ul>
            ) : null
        }
    </article>
</Layout>
